{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeDigest",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks"
  ],
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "schedule": [
    // Weekly schedule on Wednesdays 00:00–07:59
    "* 0-7 * * 3"
  ],
  automergeSchedule: [
    // Weekly schedule on Thursdays 00:00–07:59
    "* 0-7 * * 4"
  ],
  "timezone": "Europe/Berlin"
}
